# Weather APIs
OPENWEATHER_API_KEY=replace_with_your_openweather_key
WEATHERAPI_API_KEY=replace_with_your_weatherapi_key
WEATHER_CITY=Tetouan
FETCH_INTERVAL_SECONDS=30

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=weather-data

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=weather-org
INFLUXDB_BUCKET=weather-data
INFLUXDB_TOKEN=replace_with_a_long_random_token
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=replace_with_a_secure_password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_secure_password

